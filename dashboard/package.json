{
  "name": "@netri/dashboard",
  "version": "0.1.0",
  "description": "NETRI organization/admin console for live incident oversight",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node ../node_modules/vite/bin/vite.js",
    "typecheck": "node ../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && node ../node_modules/vite/bin/vite.js build",
    "preview": "node ../node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "@netri/contracts": "file:../contracts",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
